# Use uma conexão PostgreSQL agrupada do Neon ou da integração de banco da Vercel.
DATABASE_URL=postgresql://usuario:senha@host-pooler.regiao.aws.neon.tech/banco?sslmode=require

# Gere uma chave aleatória com pelo menos 32 caracteres.
JWT_SECRET=substitua-por-uma-chave-aleatoria-longa-e-segura

# Chave usada uma única vez para criar o primeiro administrador.
# Mínimo de 16 caracteres. Não compartilhe nem publique esta chave.
ADMIN_SETUP_SECRET=substitua-por-uma-chave-de-instalacao-segura

# Chave de contingência para recuperar a senha do administrador.
# Use no mínimo 24 caracteres e mantenha diferente das outras chaves.
ADMIN_RECOVERY_SECRET=substitua-por-uma-chave-de-recuperacao-longa-e-segura
